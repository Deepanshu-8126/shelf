  "distinguish_rules": {
    "hoodie": {
      "keywords": [
        "hoodie",
        "hooded",
        "hood",
        "sweatshirt",
        "fleece pullover"
      ],
      "features": "Has attached drawstring hood, front kangaroo pouch or zip, ribbed cuffs, casual fleece texture.",
      "types": {
        "Gents Oversized Hoodie": "Boxy shoulders, heavy 350-400 GSM fleece, long drop sleeves, neutral/earth/graphic tones, loose fit for men.",
        "Women Cropped Hoodie": "Short torso length hitting above navel, fitted or relaxed waist, pastel/solid colors.",
        "Unisex Zip-Up Hoodie": "Full front zipper, split front pockets, casual daily wear."
      }
    },
    "sweater": {
      "keywords": [
        "sweater",
        "cardigan",
        "knit",
        "pullover",
        "turtleneck",
        "cable knit",
        "cashmere",
        "ribbed jumper"
      ],
      "features": "Knitted yarn construction (cable knit, ribbed, fine wool), no hood, button-down (cardigan) or crewneck/turtleneck collar.",
      "types": {
        "Chunky Cable-Knit Sweater": "Thick textured rope/cable weave, soft warm winter feel.",
        "Button-Down Cardigan": "Open front with buttons, V-neck or round collar, layerable.",
        "Turtleneck / Roll-Neck Sweater": "High folded neck covering throat, fitted warm silhouette.",
        "Gents Crewneck Knit Pullover": "Classic horizontal or plain knit sweater without hood for men."
      }
    },
    "dress": {
      "keywords": [
        "dress",
        "bodycon",
        "maxi",
        "midi",
        "mini dress",
        "sundress",
        "slip dress",
        "gown"
      ],
      "types": {
        "Bodycon Maxi Dress": "Tight form-fitting stretch fabric hugging hips and bust down to ankle.",
        "Satin Slip Dress": "Glossy lightweight satin with delicate spaghetti straps and cowl/straight neckline.",
        "A-Line Floral Sundress": "Flared skirt from waist down, breezy floral cotton or chiffon."
      }
    },
    "ethnic": {
      "keywords": [
        "kurti",
        "kurta",
        "anarkali",
        "saree",
        "lehenga",
        "sharara",
        "salwar",
        "dupatta",
        "phiran"
      ],
      "types": {
        "Chikankari Kurti": "Hand or machine delicate white-on-color shadow thread embroidery.",
        "Anarkali Suit": "Fitted bodice with dramatic flared frock umbrella skirt.",
        "Saree": "Unstitched 5.5 to 6 meter drape with decorative pallu and blouse piece.",
        "Lehenga Choli": "Heavy circular flared skirt paired with fitted cropped blouse and dupatta."
      }
    },
    "bottomwear": {
      "keywords": [
        "cargo",
        "jeans",
        "denim",
        "trouser",
        "palazzo",
        "skirt",
        "jorts",
        "shorts"
      ],
      "types": {
        "Baggy Cargo Pants": "Multiple functional flap utility pockets on thighs, wide loose leg opening.",
        "Tailored Pleated Trousers": "High rise, clean front pleats, fluid formal drape.",
        "Pleated Tennis Skirt": "Short A-line skirt with sharp vertical knife pleats."
      }
    }
  }
}