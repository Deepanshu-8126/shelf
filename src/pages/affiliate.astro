---
import Layout from '../layouts/Layout.astro';
import { getAllProducts } from '../services/catalog.js';

const products = await getAllProducts();

function money(v: number) {
  return `₹${Number(v || 0).toLocaleString('en-IN')}`;
}

const PLATFORMS = ['All Platforms', 'Meesho Hub', 'Myntra Studio', 'Zara Edits', 'Amazon Fashion', 'Flipkart Drops'];
---

<Layout title="Earn With SHEF. — Creator Affiliate & Wishlink Hub" activeNav="affiliate">
  <main class="max-w-7xl mx-auto px-6 py-12">
    <!-- Creator Earnings Banner (Fluffy Glassmorphic Dashboard Card) -->
    <section class="antigravity-card p-8 md:p-12 mb-12 bg-gradient-to-br from-white/90 via-stone-50/80 to-white/95">
      <div class="flex flex-col md:flex-row md:items-center justify-between gap-8">
        <div>
          <div class="inline-flex items-center gap-2 bg-gold/10 border border-gold/30 px-3 py-1 rounded-full mb-3">
            <span class="w-2 h-2 rounded-full bg-gold"></span>
            <span class="text-[11px] uppercase tracking-[0.2em] font-semibold text-gold-dark">
              CREATOR REVENUE SUITE
            </span>
          </div>
          <h1 class="font-serif text-3xl md:text-5xl font-normal text-stone-950 leading-tight">
            Earn with <span class="italic font-serif text-gold-dark">SHEF.</span>
          </h1>
          <p class="text-stone-500 text-xs md:text-sm font-light mt-2 max-w-md">
            Curate trending fashion reels, share your custom links, and earn up to 15% instant commission on every qualifying checkout.
          </p>
        </div>

        <!-- Revenue Metrics Stack -->
        <div class="flex flex-wrap items-center gap-4 sm:gap-6 bg-white p-6 rounded-2xl border border-stone-200/80 shadow-sm">
          <div>
            <span class="text-[10px] uppercase tracking-widest font-semibold text-stone-400 block mb-1">
              Total Earnings
            </span>
            <span class="font-serif text-2xl md:text-3xl font-bold text-stone-950">
              ₹34,820
            </span>
          </div>

          <div class="h-10 w-[1px] bg-stone-200"></div>

          <div>
            <span class="text-[10px] uppercase tracking-widest font-semibold text-stone-400 block mb-1">
              Pending Payout
            </span>
            <span class="font-serif text-2xl md:text-3xl font-bold text-emerald-600">
              ₹8,450
            </span>
          </div>

          <button
            type="button"
            onclick="alert('Payout request initiated to UPI / Bank Account for ₹8,450!')"
            class="px-6 py-3 rounded-xl bg-stone-950 text-white text-xs font-semibold tracking-wider hover:bg-gold transition-colors shadow-sm"
          >
            Withdraw Now
          </button>
        </div>
      </div>
    </section>

    <!-- Platform Filter Pills -->
    <div class="flex items-center justify-between flex-wrap gap-4 mb-8 border-b border-stone-200/80 pb-6">
      <div class="flex items-center gap-2 overflow-x-auto pb-2 sm:pb-0">
        {PLATFORMS.map((plat, idx) => (
          <button
            class={`px-5 py-2 rounded-full text-xs tracking-wide transition-all ${
              idx === 0
                ? 'bg-stone-950 text-white font-semibold shadow-sm'
                : 'bg-white border border-stone-200/80 text-stone-600 hover:text-stone-950 hover:bg-stone-100/80 font-medium'
            }`}
          >
            {plat}
          </button>
        ))}
      </div>

      <div class="text-xs text-stone-400 font-medium">
        Showing <span class="text-stone-900 font-bold">{products.length}</span> Curated High-Yield Listings
      </div>
    </div>

    <!-- Affiliate Product Grid (With Commission Badges & Share Buttons) -->
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
      {products.map((p) => {
        const estCommission = Math.round(p.price * 0.12);
        return (
          <div class="antigravity-card overflow-hidden flex flex-col justify-between p-4 group">
            <!-- Image & Commission Badge -->
            <div class="relative aspect-[4/5] bg-stone-100 rounded-xl overflow-hidden mb-4">
              <img
                src={p.image}
                alt={p.title}
                loading="lazy"
                referrerpolicy="no-referrer"
                class="w-full h-full object-cover object-center transition-transform duration-500 group-hover:scale-105"
              />
              
              <!-- Commission Highlight Badge -->
              <div class="absolute top-3 left-3 bg-emerald-600 text-white text-[11px] font-bold tracking-wider px-3 py-1 rounded-full shadow-md">
                Earn {money(estCommission)}
              </div>

              <!-- Store Tag -->
              <span class="absolute bottom-3 right-3 bg-white/95 text-stone-900 text-[10px] font-semibold px-2 py-0.5 rounded border border-stone-200">
                Meesho 374453404
              </span>
            </div>

            <!-- Content Area -->
            <div>
              <div class="flex items-center justify-between text-[10px] text-stone-400 uppercase tracking-widest font-semibold mb-1">
                <span>{p.category}</span>
                <span class="text-gold font-mono">{p.meeshoCode}</span>
              </div>
              <h3 class="font-serif text-sm font-normal text-stone-900 line-clamp-1 leading-snug mb-2">
                {p.title}
              </h3>
              <div class="flex items-baseline gap-2 mb-4">
                <span class="font-serif text-base font-semibold text-stone-950">{money(p.price)}</span>
                <span class="text-xs text-stone-400 line-through">{money(p.mrp)}</span>
                <span class="text-[10px] font-bold text-rose-600 ml-auto">{p.discount}</span>
              </div>
            </div>

            <!-- Creator Action Buttons: Copy Link + WhatsApp Share -->
            <div class="grid grid-cols-2 gap-2 pt-2 border-t border-stone-100">
              <button
                type="button"
                data-link={p.affiliateUrl}
                onclick={`navigator.clipboard.writeText('${p.affiliateUrl}'); const el = this; el.innerText = 'Copied! ✓'; setTimeout(() => { el.innerText = 'Copy Link'; }, 2000);`}
                class="py-2.5 px-3 rounded-lg bg-stone-100 text-stone-900 hover:bg-stone-200 text-xs font-semibold tracking-wide transition-colors text-center"
              >
                Copy Link
              </button>

              <a
                href={`https://api.whatsapp.com/send?text=${encodeURIComponent(`Check out this trending outfit at ₹${p.price} (${p.discount}): ${p.affiliateUrl}`)}`}
                target="_blank"
                rel="noopener noreferrer"
                class="py-2.5 px-3 rounded-lg bg-emerald-600 text-white hover:bg-emerald-700 text-xs font-semibold tracking-wide transition-colors text-center flex items-center justify-center gap-1"
              >
                <span>Share</span>
                <span>↗</span>
              </a>
            </div>
          </div>
        );
      })}
    </div>
  </main>
</Layout>
