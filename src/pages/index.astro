---
import Layout from '../layouts/Layout.astro';
import { getAllProducts } from '../services/catalog.js';

const products = await getAllProducts();

function money(v) {
  return `₹${Number(v || 0).toLocaleString('en-IN')}`;
}

const CATEGORIES = [
  {
    title: 'Women Haute Edit',
    subtitle: 'Silks, corset tops, ribbed knitwear & flare dresses',
    image: 'https://images.unsplash.com/photo-1515886657613-9f3515b0c78f?auto=format&fit=crop&w=900&q=80',
    tag: 'EXPLORE WOMEN',
    filter: 'Women Dresses',
  },
  {
    title: 'Men Minimal Tailoring',
    subtitle: 'Relaxed oversized tees, boxy jackets & neutrals',
    image: 'https://images.unsplash.com/photo-1507679799987-c73779587ccf?auto=format&fit=crop&w=900&q=80',
    tag: 'EXPLORE MEN',
    filter: 'Tops & Tunics',
  },
  {
    title: 'Sculpted Accessories',
    subtitle: 'Liquid chrome studs, chunky totes & gold accents',
    image: 'https://images.unsplash.com/photo-1535632066927-ab7c9ab60908?auto=format&fit=crop&w=900&q=80',
    tag: 'EXPLORE OBJECTS',
    filter: 'Accessories',
  },
];

const FILTER_PILLS = ['All Picks', 'Tops & Tunics', 'Kurtis', 'Ethnic Wear', 'Women Dresses', 'Winter Outerwear', 'Accessories'];
---

<Layout title="SHEF. — Luxury Fashion Reseller & Curated Creator Drops" activeNav="store">
  <!-- Full-Width Editorial Hero Banner -->
  <section class="relative w-full min-h-[85vh] flex items-center justify-center bg-stone-100 overflow-hidden border-b border-stone-200/80">
    <div class="absolute inset-0 z-0">
      <img
        src="https://images.unsplash.com/photo-1490481651871-ab68de25d43d?auto=format&fit=crop&w=2000&q=85"
        alt="Editorial Fashion Model"
        class="w-full h-full object-cover object-center opacity-90 scale-105 transition-transform duration-1000 ease-out hover:scale-100"
      />
      <div class="absolute inset-0 bg-gradient-to-r from-stone-950/85 via-stone-950/45 to-transparent"></div>
    </div>

    <div class="relative z-10 max-w-7xl mx-auto px-6 py-20 w-full text-white">
      <div class="max-w-2xl">
        <div class="inline-flex items-center gap-2 bg-white/10 backdrop-blur-md border border-white/20 px-3.5 py-1 rounded-full mb-6">
          <span class="w-2 h-2 rounded-full bg-gold animate-pulse"></span>
          <span class="text-[11px] uppercase tracking-[0.2em] font-medium text-stone-200">
            AUTUMN / WINTER 2026 DROP
          </span>
        </div>

        <h1 class="font-serif text-5xl md:text-7xl font-normal tracking-tight leading-[1.08] mb-6">
          Elevate Your <br />
          <span class="italic font-light text-gold-light">Everyday.</span>
        </h1>

        <p class="text-stone-300 text-base md:text-lg font-light leading-relaxed max-w-lg mb-8">
          The curated resale collective. Discover high-editorial pieces from verified fashion merchants at authentic lowest wholesale rates.
        </p>

        <div class="flex flex-wrap items-center gap-4">
          <a
            href="#trending"
            class="px-8 py-4 rounded-full bg-white text-stone-950 text-xs uppercase tracking-widest font-semibold hover:bg-gold hover:text-white transition-all duration-300 shadow-lg hover:shadow-gold/20"
          >
            Shop The Collection
          </a>
          <a
            href="/affiliate"
            class="px-8 py-4 rounded-full bg-white/10 backdrop-blur-md border border-white/30 text-white text-xs uppercase tracking-widest font-semibold hover:bg-white/20 transition-all duration-300"
          >
            Earn With Wishlink
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- Editorial Category Grid (3-Column Spaces) -->
  <section class="max-w-7xl mx-auto px-6 py-24">
    <div class="flex flex-col md:flex-row md:items-end justify-between mb-12">
      <div>
        <span class="text-xs font-semibold uppercase tracking-[0.25em] text-gold">CURATED SPACES</span>
        <h2 class="font-serif text-3xl md:text-4xl font-normal text-stone-950 mt-1">Explore By Category</h2>
      </div>
      <p class="text-stone-500 text-xs md:text-sm font-light mt-2 md:mt-0 max-w-xs">
        Handpicked seasonal edits structured for effortless wardrobe building.
      </p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
      {CATEGORIES.map((cat) => (
        <a href="#trending" class="group relative block aspect-[3/4] rounded-2xl overflow-hidden shadow-float">
          <img
            src={cat.image}
            alt={cat.title}
            class="w-full h-full object-cover transition-transform duration-700 ease-out group-hover:scale-105"
          />
          <div class="absolute inset-0 bg-gradient-to-t from-stone-950/90 via-stone-950/20 to-transparent"></div>
          
          <div class="absolute inset-0 p-8 flex flex-col justify-end text-white">
            <span class="text-[10px] uppercase tracking-[0.25em] font-semibold text-gold mb-2">{cat.tag}</span>
            <h3 class="font-serif text-2xl font-normal mb-2 leading-tight">{cat.title}</h3>
            <p class="text-xs text-stone-300 font-light line-clamp-2 mb-4 leading-relaxed">{cat.subtitle}</p>
            <span class="inline-flex items-center gap-2 text-xs font-medium tracking-wider text-white group-hover:text-gold transition-colors">
              <span>View Lookbook</span>
              <span class="transform group-hover:translate-x-1 transition-transform">→</span>
            </span>
          </div>
        </a>
      ))}
    </div>
  </section>

  <!-- Trending Haute Products Grid -->
  <section id="trending" class="max-w-7xl mx-auto px-6 pb-24 scroll-mt-24">
    <div class="flex flex-col md:flex-row md:items-end justify-between mb-10">
      <div>
        <span class="text-xs font-semibold uppercase tracking-[0.25em] text-gold">THE EDIT</span>
        <h2 class="font-serif text-3xl md:text-4xl font-normal text-stone-950 mt-1">Trending Verified Drops</h2>
      </div>
      <div class="flex items-center gap-2 mt-4 md:mt-0 overflow-x-auto pb-2">
        {FILTER_PILLS.map((pill, idx) => (
          <button
            type="button"
            onclick="filterStoreCategory(this.innerText)"
            class={`px-5 py-2 rounded-full text-xs tracking-wide transition-all ${
              idx === 0
                ? 'bg-stone-950 text-white font-semibold shadow-sm store-filter-active'
                : 'bg-white border border-stone-200/80 text-stone-600 hover:text-stone-950 hover:bg-stone-100/80 font-medium'
            }`}
          >
            {pill}
          </button>
        ))}
      </div>
    </div>

    <!-- Product Card Grid -->
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-8" id="storefrontGrid">
      {products.map((p) => (
        <div class="antigravity-card flex flex-col justify-between overflow-hidden group p-3 bg-white store-product-item" data-category={p.category}>
          <!-- Product Image Container -->
          <div class="relative aspect-[3/4] bg-stone-100 rounded-xl overflow-hidden mb-4">
            <img
              src={p.image}
              alt={p.title}
              loading="lazy"
              referrerpolicy="no-referrer"
              class="w-full h-full object-cover object-center group-hover:scale-105 transition-transform duration-700 ease-out"
            />
            
            {p.discount && (
              <span class="absolute top-3 left-3 bg-stone-950/80 backdrop-blur-md text-white text-[10px] font-semibold tracking-wider px-2.5 py-1 rounded-full uppercase border border-white/10">
                {p.discount}
              </span>
            )}

            <button
              type="button"
              onclick={`navigator.clipboard.writeText('${p.affiliateUrl}'); alert('Meesho Link Copied!');`}
              class="absolute top-3 right-3 w-8 h-8 rounded-full bg-white/90 backdrop-blur-md flex items-center justify-center text-stone-700 hover:text-gold shadow-sm opacity-0 group-hover:opacity-100 transition-opacity duration-300"
              title="Copy Link"
            >
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71"/><path d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71"/></svg>
            </button>
          </div>

          <!-- Product Details -->
          <div class="flex-1 flex flex-col justify-between px-1">
            <div>
              <div class="flex items-center justify-between text-[11px] text-stone-400 mb-1">
                <span>{p.category}</span>
                <span class="font-mono text-gold-dark font-semibold">{p.meeshoCode || 's-find'}</span>
              </div>
              <h3 class="font-serif text-base font-normal text-stone-900 group-hover:text-gold transition-colors line-clamp-1 mb-2" title={p.title}>
                {p.title}
              </h3>
            </div>

            <div class="pt-2 border-t border-stone-100 mt-2">
              <div class="flex items-baseline justify-between mb-4">
                <div class="flex items-baseline gap-2">
                  <span class="font-serif text-lg font-bold text-stone-950">{money(p.price)}</span>
                  <span class="text-xs text-stone-400 line-through">{money(p.mrp)}</span>
                </div>
                <span class="text-[11px] font-semibold text-emerald-600">Verified Low</span>
              </div>

              <!-- Action Buttons -->
              <div class="grid grid-cols-2 gap-2">
                <a
                  href={p.affiliateUrl}
                  target="_blank"
                  rel="noopener"
                  class="py-2.5 px-3 rounded-xl bg-stone-950 text-white text-[11px] font-semibold text-center hover:bg-gold transition-colors duration-200 shadow-sm"
                >
                  Shop Meesho ↗
                </a>
                <a
                  href={`https://api.whatsapp.com/send?phone=916486771356&text=Hi%20SHEF.%20I%20want%20to%20order%20${encodeURIComponent(p.title)}%20(${p.meeshoCode})%20for%20${money(p.price)}%20via%20COD.`}
                  target="_blank"
                  rel="noopener"
                  class="py-2.5 px-3 rounded-xl bg-stone-100 hover:bg-stone-200/80 text-stone-900 text-[11px] font-semibold text-center border border-stone-200 transition-colors duration-200"
                >
                  WhatsApp COD
                </a>
              </div>
            </div>
          </div>
        </div>
      ))}
    </div>
  </section>

  <script is:inline>
    function filterStoreCategory(cat) {
      document.querySelectorAll('#trending button').forEach(b => {
        b.classList.remove('bg-stone-950', 'text-white', 'font-semibold', 'shadow-sm');
        b.classList.add('bg-white', 'text-stone-600', 'border', 'border-stone-200/80');
      });
      event.target.classList.add('bg-stone-950', 'text-white', 'font-semibold', 'shadow-sm');
      event.target.classList.remove('bg-white', 'text-stone-600', 'border', 'border-stone-200/80');

      const items = document.querySelectorAll('.store-product-item');
      items.forEach(item => {
        const itemCat = item.getAttribute('data-category') || '';
        if (cat === 'All Picks' || itemCat.toLowerCase().includes(cat.toLowerCase()) || cat.toLowerCase().includes(itemCat.toLowerCase())) {
          item.style.display = '';
        } else {
          item.style.display = 'none';
        }
      });
    }
  </script>
</Layout>