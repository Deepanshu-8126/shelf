---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import { getAllProducts } from '../services/catalog.js';

const products = await getAllProducts();
---

<Layout title="shelf. — Creator & Admin Studio">
  <Header activeTab="admin" />

  <main class="admin-container container">
    <!-- Admin Header -->
    <div class="admin-header-row">
      <div>
        <div class="admin-badge">
          <span class="pulse-dot"></span>
          <span>CREATOR STUDIO & BACKOFFICE</span>
        </div>
        <h1 class="admin-title">Admin Dashboard</h1>
        <p class="admin-subtitle">Manage dropship orders, Google Veo reels, Wishlink catalog & Meesho affiliate sync.</p>
      </div>

      <div class="admin-stats-row">
        <div class="stat-box">
          <span class="stat-num">{products.length}</span>
          <span class="stat-label">Active Listings</span>
        </div>
        <div class="stat-box">
          <span class="stat-num">₹18,450</span>
          <span class="stat-label">Est. Revenue</span>
        </div>
        <div class="stat-box">
          <span class="stat-num">374453404</span>
          <span class="stat-label">Affiliate ID</span>
        </div>
      </div>
    </div>

    <!-- Quick Navigation Grid -->
    <div class="quick-tools-grid">
      <!-- Tool 1: Veo Video Studio -->
      <div class="tool-card">
        <div class="tool-icon-wrap" style="background: rgba(236, 72, 153, 0.15); color: #ec4899;">
          ✨
        </div>
        <div class="tool-details">
          <h3>Google Veo 3.1 Studio</h3>
          <p>Generate 4K 60fps AI model fashion reels with auto prompt synthesis & Telegram dispatch.</p>
          <a href="https://t.me/ubstabot" target="_blank" rel="noopener" class="tool-btn">
            Open Telegram Bot (@Bbyjihotbot) →
          </a>
        </div>
      </div>

      <!-- Tool 2: Dropship Customer Orders -->
      <div class="tool-card">
        <div class="tool-icon-wrap" style="background: rgba(16, 185, 129, 0.15); color: #10b981;">
          📦
        </div>
        <div class="tool-details">
          <h3>Customer Orders & Dropship</h3>
          <p>View live customer COD bookings, addresses, phone numbers & fulfillment statuses.</p>
          <a href="https://supabase.com/dashboard/project/fniiiqowbvzcqaqbyjlb" target="_blank" rel="noopener" class="tool-btn">
            Open Supabase Cloud DB →
          </a>
        </div>
      </div>

      <!-- Tool 3: Chrome All-in-One Extension -->
      <div class="tool-card">
        <div class="tool-icon-wrap" style="background: rgba(59, 130, 246, 0.15); color: #3b82f6;">
          🧩
        </div>
        <div class="tool-details">
          <h3>Visual Grid Scraper Extension</h3>
          <p>1-Click Meesho & Pinterest multi-photo picker (`extension/shelf-all-in-one`).</p>
          <span class="tool-status">Installed in Brave/Chrome</span>
        </div>
      </div>
    </div>

    <!-- Live Products Management Table -->
    <section class="products-table-section">
      <div class="section-title-row">
        <h2>Live Catalog Inventory ({products.length})</h2>
        <a href="https://www.meesho.com" target="_blank" rel="noopener" class="add-btn">
          + Open Meesho to Curate
        </a>
      </div>

      <div class="table-wrapper">
        <table class="products-table">
          <thead>
            <tr>
              <th>Image</th>
              <th>Product Title</th>
              <th>Category</th>
              <th>Price</th>
              <th>MRP</th>
              <th>Discount</th>
              <th>Meesho Search Code</th>
              <th>Affiliate Direct Link</th>
            </tr>
          </thead>
          <tbody>
            {products.map((p) => (
              <tr>
                <td>
                  <img src={p.image} alt={p.title} class="thumb-img" referrerpolicy="no-referrer" />
                </td>
                <td class="col-title" title={p.title}>{p.title}</td>
                <td><span class="cat-pill">{p.category}</span></td>
                <td class="col-price">₹{p.price}</td>
                <td class="col-mrp">₹{p.mrp}</td>
                <td><span class="disc-pill">{p.discount}</span></td>
                <td><code class="code-pill">{p.meeshoCode || 's-find'}</code></td>
                <td>
                  <a href={p.affiliateUrl} target="_blank" rel="noopener" class="link-btn">
                    Visit Link ↗
                  </a>
                </td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </section>
  </main>
</Layout>

<style>
  .admin-container {
    padding-top: 2.5rem;
    padding-bottom: 5rem;
  }

  .admin-header-row {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: 2rem;
    margin-bottom: 2.5rem;
    flex-wrap: wrap;
  }

  .admin-badge {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    background: rgba(236, 72, 153, 0.08);
    border: 1px solid rgba(236, 72, 153, 0.25);
    color: var(--accent-pink);
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.06em;
    padding: 0.35rem 0.85rem;
    border-radius: 9999px;
    margin-bottom: 0.75rem;
  }

  .pulse-dot {
    width: 6px;
    height: 6px;
    background: var(--accent-pink);
    border-radius: 50%;
    box-shadow: 0 0 8px var(--accent-pink);
  }

  .admin-title {
    font-family: var(--font-heading);
    font-size: 2.25rem;
    font-weight: 800;
    color: #ffffff;
    letter-spacing: -0.03em;
  }

  .admin-subtitle {
    font-size: 0.95rem;
    color: var(--text-muted);
    margin-top: 0.35rem;
  }

  .admin-stats-row {
    display: flex;
    gap: 1rem;
    flex-wrap: wrap;
  }

  .stat-box {
    background: var(--bg-surface);
    border: 1px solid var(--border-subtle);
    padding: 1rem 1.25rem;
    border-radius: 12px;
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
    min-width: 130px;
  }

  .stat-num {
    font-family: var(--font-heading);
    font-size: 1.35rem;
    font-weight: 800;
    color: #ffffff;
  }

  .stat-label {
    font-size: 0.72rem;
    color: var(--text-muted);
    text-transform: uppercase;
    letter-spacing: 0.04em;
    font-weight: 600;
  }

  .quick-tools-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 1.25rem;
    margin-bottom: 3rem;
  }

  .tool-card {
    background: var(--bg-surface);
    border: 1px solid var(--border-subtle);
    border-radius: 16px;
    padding: 1.5rem;
    display: flex;
    gap: 1rem;
    transition: transform 0.2s ease, border-color 0.2s ease;
  }

  .tool-card:hover {
    border-color: rgba(255, 255, 255, 0.2);
    transform: translateY(-2px);
  }

  .tool-icon-wrap {
    width: 44px;
    height: 44px;
    border-radius: 10px;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 1.25rem;
    flex-shrink: 0;
  }

  .tool-details h3 {
    font-size: 1rem;
    font-weight: 700;
    color: #ffffff;
    margin-bottom: 0.35rem;
  }

  .tool-details p {
    font-size: 0.8rem;
    color: var(--text-muted);
    line-height: 1.45;
    margin-bottom: 0.85rem;
  }

  .tool-btn {
    display: inline-block;
    font-size: 0.8rem;
    font-weight: 700;
    color: var(--accent-pink);
    transition: color 0.2s ease;
  }

  .tool-btn:hover {
    color: #f472b6;
    text-decoration: underline;
  }

  .tool-status {
    font-size: 0.75rem;
    color: var(--accent-emerald);
    font-weight: 600;
  }

  .products-table-section {
    background: var(--bg-surface);
    border: 1px solid var(--border-subtle);
    border-radius: 16px;
    padding: 1.5rem;
  }

  .section-title-row {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 1.25rem;
    flex-wrap: wrap;
    gap: 0.75rem;
  }

  .section-title-row h2 {
    font-size: 1.25rem;
    font-weight: 700;
    color: #ffffff;
  }

  .add-btn {
    background: var(--bg-card);
    border: 1px solid var(--border-subtle);
    color: var(--text-main);
    font-size: 0.8rem;
    font-weight: 600;
    padding: 0.45rem 0.95rem;
    border-radius: 8px;
    transition: all 0.2s ease;
  }

  .add-btn:hover {
    border-color: var(--accent-pink);
    color: var(--accent-pink);
  }

  .table-wrapper {
    overflow-x: auto;
  }

  .products-table {
    width: 100%;
    border-collapse: collapse;
    text-align: left;
    font-size: 0.85rem;
  }

  .products-table th {
    background: var(--bg-card);
    color: var(--text-muted);
    font-weight: 600;
    padding: 0.75rem 1rem;
    border-bottom: 1px solid var(--border-subtle);
    white-space: nowrap;
  }

  .products-table td {
    padding: 0.85rem 1rem;
    border-bottom: 1px solid rgba(255, 255, 255, 0.04);
    vertical-align: middle;
  }

  .thumb-img {
    width: 44px;
    height: 52px;
    object-fit: cover;
    border-radius: 6px;
    background: #0f0f13;
  }

  .col-title {
    font-weight: 600;
    color: #ffffff;
    max-width: 240px;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .cat-pill {
    background: rgba(255, 255, 255, 0.06);
    padding: 0.2rem 0.5rem;
    border-radius: 4px;
    font-size: 0.75rem;
    color: var(--text-muted);
    white-space: nowrap;
  }

  .col-price {
    font-family: var(--font-heading);
    font-weight: 700;
    color: #ffffff;
  }

  .col-mrp {
    color: var(--text-muted);
    text-decoration: line-through;
    font-size: 0.8rem;
  }

  .disc-pill {
    background: rgba(225, 29, 72, 0.15);
    color: #fb7185;
    padding: 0.2rem 0.45rem;
    border-radius: 4px;
    font-size: 0.7rem;
    font-weight: 700;
    white-space: nowrap;
  }

  .code-pill {
    background: #09090b;
    border: 1px solid var(--border-subtle);
    padding: 0.25rem 0.5rem;
    border-radius: 4px;
    color: #facc15;
    font-size: 0.75rem;
  }

  .link-btn {
    color: var(--accent-pink);
    font-weight: 600;
    font-size: 0.8rem;
    white-space: nowrap;
  }

  .link-btn:hover {
    text-decoration: underline;
  }
</style>
