---
// Layout.astro - Base layout for SHEF
// Includes global styles, fonts, and the antigravity design system
---
<!DOCTYPE html>
<html lang="en" class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>SHEF - Elevate Your Everyday</title>
    <!-- Google Fonts: Playfair Display for headings, Inter for body -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&family=Playfair+Display:wght@400;500;600;700&display=swap" rel="stylesheet" />
    <!-- Tailwind CSS CDN (for prototype) -->
    <script src="https://cdn.tailwindcss.com"></script>
    <script>
      // Custom Tailwind configuration for Antigravity design system
      tailwind.config = {
        theme: {
          extend: {
            colors: {
              background: '#FAFAF9',
              text: '#0C0A09',
              gold: '#B49B67',
              stone: {
                400: '#A8A29E',
                950: '#0C0A09',
                50: '#FAFAF9',
                100: '#F5F5F4',
              },
            },
            fontFamily: {
              playfair: ['Playfair Display', 'serif'],
              inter: ['Inter', 'sans-serif'],
            },
            boxShadow: {
              'antigravity': '0 20px 40px -10px rgba(0, 0, 0, 0.05)',
            },
            transitionDuration: {
              DEFAULT: '300ms',
            },
          },
        },
      }
    </script>
    <!-- Global CSS for antigravity card effect -->
    <style>
      .antigravity-card {
        @apply bg-white/80 backdrop-blur-md border border-stone-100 shadow-antigravity transition-all hover:-translate-y-1;
      }
    </style>
  </head>
  <body class="bg-background text-text antialiased">
    <div class="min-h-screen flex flex-col">
      <!-- Navbar -->
      <header class="bg-white/60 backdrop-blur-md border-b border-stone-100 sticky top-0 z-50">
        <nav class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
          <div class="flex justify-between h-16">
            <div class="flex items-center">
              <!-- Logo -->
              <a href="/" class="flex items-center space-x-2">
                <span class="text-xl font-playfair font-semibold text-text">SHEF.</span>
              </a>
              <!-- Navigation Links -->
              <div class="hidden md:flex space-x-6">
                <a href="/store" class="text-text/60 hover:text-text transition-colors font-medium">Store</a>
                <a href="/affiliate" class="text-text/60 hover:text-text transition-colors font-medium">Affiliate Hub</a>
                <a href="/admin" class="text-text/60 hover:text-text transition-colors font-medium">Admin</a>
              </div>
            </div>
            <div class="flex items-center space-x-4">
              <!-- Search Icon -->
              <button class="p-2 rounded-hover text-text/60 hover:text-text">
                <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" viewBox="0 0 20 20" fill="currentColor">
                  <path fill-rule="evenodd" d="M8 4a4 4 0 100 8 4 4 0 000-8zM2 8a6 6 0 1110.89 3.476l4.817 4.817a1 1 0 01-1.414 1.414l-4.816-4.816A6 6 0 012 8z" clip-rule="evenodd" />
                </svg>
              </button>
              <!-- Cart Icon -->
              <button class="p-2 rounded-hover text-text/60 hover:text-text relative">
                <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" viewBox="0 0 20 20" fill="currentColor">
                  <path fill-rule="evenodd" d="M3 1a1 1 0 011-1h1.586a1 1 0 01.707.293l2.414 2.414a1 1 0 01.415.415l.828.828A1 1 0 019.414 11H13a1 1 0 011 1v2a1 1 0 01-1 1v1a1 1 0 01-1 1H6.414l-.707.707A1 1 0 015 15.414V13a1 1 0 01-1-1H3a1 1 0 01-1-1V4a1 1 0 011-1h1zm13 0a1 1 0 011-1h.586l.707.707A1 1 0 0116.414 3H15a1 1 0 011 1v1a1 1 0 01-1 1h-1.586l-.707-.707A1 1 0 0113.414 2H14a1 1 0 011-1v-1z" clip-rule="evenodd" />
                </svg>
                <!-- Cart Badge -->
                <div class="absolute -top-1 -right-1 flex h-5 w-5 items-center justify-center rounded-full bg-gold text-white text-xs">
                  3
                </div>
              </button>
            </div>
          </div>
        </nav>
      </header>

      <!-- Main Content -->
      <main class="flex-1 w-full">
        <slot />
      </main>

      <!-- Footer -->
      <footer class="bg-white/60 backdrop-blur-md border-t border-stone-100">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
          <div class="grid grid-cols-1 md:grid-cols-3 gap-6 text-text/60">
            <div>
              <h3 class="font-playfair font-semibold text-text mb-4">About SHEF</h3>
              <p class="space-y-2">
                SHEF redefines fashion discovery with a premium, antigravity experience. 
                We curate the finest styles and empower our community to earn through authentic recommendations.
              </p>
            </div>
            <div class="space-y-2">
              <h3 class="font-playfair font-semibold text-text mb-4">Navigate</h3>
              <ul class="space-y-1">
                <li><a href="/" class="hover:text-text transition-colors">Home</a></li>
                <li><a href="/store" class="hover:text-text transition-colors">Store</a></li>
                <li><a href="/affiliate" class="hover:text-text transition-colors">Affiliate Hub</a></li>
                <li><a href="/admin" class="hover:text-text transition-colors">Admin</a></li>
              </ul>
            </div>
            <div class="space-y-2">
              <h3 class="font-playfair font-semibold text-text mb-4">Follow Us</h3>
              <div class="flex space-x-4">
                <a href="#" class="hover:text-text transition-colors">
                  <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" viewBox="0 0 24 24" fill="currentColor">
                    <path d="M12 0C5.373 0 0 5.373 0 12c0 5.303 3.438 9.8 8.205 11.387-.15.148-.305.222-.455.222-.225 0-.448-.027-.659-.077v1.973c0 .558.045 1.011.175 1.402l-.475 2.257c-.347.205-.78.313-1.232.286v2.164l3.042-.362c.84.097 1.555-.242 2.012-.682l2.322-2.937c1.01-.308 1.638-1.05 1.855-2.087h2.475c.138-.656.217-1.332.217-2.042 0-6.627-5.373-12-12-12z" />
                  </svg>
                </a>
                <a href="#" class="hover:text-text transition-colors">
                  <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" viewBox="0 0 24 24" fill="currentColor">
                    <path d="M12 2.163c3.204 0 5.801 2.597 5.801 5.801S18.368 13.765 12 13.765c-1.356 0-2.608-.402-3.63-1.084l-2.738 3.55 1.33 2.086c-.476.731-1.087 1.184-1.806 1.184-.72 0-1.332-.29-1.719-.768l-1.321-2.095-2.74 3.547c-.608.786-1.405 1.289-2.284 1.289-1.214 0-2.182-.968-2.182-2.162 0-1.194.625-2.195 1.434-2.542l2.054-1.328c.148-.24.233-.523.233-.819 0-.45-.113-.881-.318-1.191l1.856-1.203c.438.649 1.05 1.021 1.773 1.021.966 0 1.751-.785 1.751-1.752 0-.967-.785-1.752-1.752-1.752z" />
                  </svg>
                </a>
              </div>
            </div>
          </div>
          <div class="mt-8 pt-4 border-t border-stone-200 text-center text-text/40">
            &copy; <span id="year"></span> SHEF. All rights reserved.
          </div>
        </div>
      </footer>

      <script>
        // Set current year in footer
        document.getElementById('year').textContent = new Date().getFullYear();
      </script>
    </div>
  </body>
</html>