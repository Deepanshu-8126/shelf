---
interface Props {
  title?: string;
  activeTab?: string;
}

const {
  title = 'SHEF. — Executive Backoffice & Admin Studio',
  activeTab = 'dashboard',
} = Astro.props;
---

<!doctype html>
<html lang="en" class="scroll-smooth bg-stone-900">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="robots" content="noindex, nofollow" />

    <!-- Google Fonts: Inter + Playfair -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&family=JetBrains+Mono:wght@400;500;600&family=Playfair+Display:wght@500;600;700&display=swap" rel="stylesheet" />

    <!-- Tailwind CSS CDN with is:inline -->
    <script is:inline src="https://cdn.tailwindcss.com"></script>
    <script is:inline>
      tailwind.config = {
        theme: {
          extend: {
            colors: {
              stone: {
                50: '#FAFAF9',
                100: '#F5F5F4',
                200: '#E7E5E4',
                300: '#D6D3D1',
                400: '#A8A29E',
                500: '#78716C',
                600: '#57534E',
                700: '#44403C',
                800: '#292524',
                900: '#1C1917',
                950: '#0C0A09',
              },
              gold: {
                light: '#E6D5B8',
                DEFAULT: '#B49B67',
                dark: '#8C7443',
              },
            },
            fontFamily: {
              sans: ['Inter', 'system-ui', 'sans-serif'],
              serif: ['"Playfair Display"', 'Georgia', 'serif'],
              mono: ['"JetBrains Mono"', 'monospace'],
            },
          },
        },
      };
    </script>

    <style is:global>
      body {
        background-color: #0c0a09;
        color: #f5f5f4;
        font-family: 'Inter', system-ui, sans-serif;
        -webkit-font-smoothing: antialiased;
      }
      .admin-panel {
        background: rgba(28, 25, 23, 0.85);
        backdrop-filter: blur(16px);
        -webkit-backdrop-filter: blur(16px);
        border: 1px solid rgba(68, 64, 60, 0.6);
        border-radius: 1rem;
      }
      .admin-panel-card {
        background: #1c1917;
        border: 1px solid #292524;
        border-radius: 0.875rem;
        transition: all 0.2s ease;
      }
      .admin-panel-card:hover {
        border-color: #44403c;
      }
      /* Custom dark scrollbar */
      ::-webkit-scrollbar {
        width: 6px;
        height: 6px;
      }
      ::-webkit-scrollbar-track {
        background: #1c1917;
      }
      ::-webkit-scrollbar-thumb {
        background: #44403c;
        border-radius: 3px;
      }
      ::-webkit-scrollbar-thumb:hover {
        background: #78716c;
      }
    </style>
  </head>
  <body class="min-h-screen flex flex-col bg-stone-950 text-stone-100">
    <!-- Dedicated Executive Admin Header Bar -->
    <header class="sticky top-0 z-50 bg-stone-900/95 backdrop-blur-xl border-b border-stone-800">
      <div class="max-w-[1600px] mx-auto px-4 sm:px-8 h-16 flex items-center justify-between">
        <!-- Brand & Studio Title -->
        <div class="flex items-center gap-4">
          <a href="/admin" class="flex items-center gap-2">
            <span class="font-serif text-2xl font-bold tracking-tight text-white">
              SHEF<span class="text-gold">.</span>
            </span>
            <span class="text-[10px] uppercase font-mono tracking-wider font-semibold bg-gold/15 text-gold px-2.5 py-0.5 rounded border border-gold/30">
              STUDIO ADMIN
            </span>
          </a>

          <div class="hidden md:flex items-center gap-2 pl-4 border-l border-stone-800 text-xs text-stone-400">
            <span class="inline-block w-2 h-2 rounded-full bg-emerald-500 animate-pulse"></span>
            <span>Supabase Cloud Connected</span>
            <span class="text-stone-600">·</span>
            <span class="font-mono text-stone-300">ID: 374453404</span>
          </div>
        </div>

        <!-- Admin Actions & Live Store Link -->
        <div class="flex items-center gap-3">
          <a
            href="/"
            target="_blank"
            class="flex items-center gap-1.5 text-xs font-semibold bg-stone-800 hover:bg-stone-700 text-stone-200 px-3.5 py-2 rounded-lg border border-stone-700 transition-colors"
            title="Open live customer storefront"
          >
            <span>View Live Store</span>
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"></path><polyline points="15 3 21 3 21 9"></polyline><line x1="10" x2="21" y1="14" y2="3"></line></svg>
          </a>

          <a
            href="/affiliate"
            target="_blank"
            class="hidden sm:flex items-center gap-1.5 text-xs font-semibold bg-stone-800 hover:bg-stone-700 text-stone-200 px-3.5 py-2 rounded-lg border border-stone-700 transition-colors"
          >
            <span>Affiliate Hub</span>
          </a>

          <div class="flex items-center gap-2.5 pl-3 border-l border-stone-800">
            <div class="w-8 h-8 rounded-full bg-gold/20 text-gold border border-gold/40 flex items-center justify-center font-bold text-xs">
              DK
            </div>
            <div class="hidden lg:block text-left">
              <div class="text-xs font-semibold text-stone-200">Deepanshu K.</div>
              <div class="text-[10px] text-stone-400">Master Administrator</div>
            </div>
          </div>
        </div>
      </div>
    </header>

    <!-- Main Content Slot -->
    <main class="flex-1 max-w-[1600px] w-full mx-auto px-4 sm:px-8 py-8">
      <slot />
    </main>

    <!-- Admin Footer Bar -->
    <footer class="bg-stone-900 border-t border-stone-800 py-4 px-8 text-xs text-stone-500 flex flex-col sm:flex-row items-center justify-between">
      <div>
        <span>SHEF. Enterprise Resale Operating System v3.2</span>
        <span class="mx-2">·</span>
        <span class="text-stone-400">Astro Framework + Supabase Cloud Engine</span>
      </div>
      <div class="mt-2 sm:mt-0 font-mono text-stone-400">
        Status: <span class="text-emerald-400 font-semibold">ALL ENGINES ONLINE</span>
      </div>
    </footer>
  </body>
</html>
