---
const { activeTab = 'store' } = Astro.props;
---

<header class="site-header">
  <div class="container header-inner">
    <a href="/" class="brand-logo">
      <span class="logo-text">shelf<span class="logo-dot">.</span></span>
      <span class="badge-mini">VERIFIED FINDS</span>
    </a>

    <nav class="nav-links">
      <a href="/" class={`nav-item ${activeTab === 'store' ? 'active' : ''}`}>
        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M6 2 3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4Z"/><line x1="3" x2="21" y1="6" y2="6"/><path d="M16 10a4 4 0 0 1-8 0"/></svg>
        <span>Storefront</span>
      </a>
      <a href="/haul" class={`nav-item ${activeTab === 'haul' ? 'active' : ''}`}>
        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71"/><path d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71"/></svg>
        <span>Wishlink Creator Haul</span>
      </a>
      <a href="/admin" class={`nav-item ${activeTab === 'admin' ? 'active' : ''}`}>
        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect width="18" height="18" x="3" y="3" rx="2"/><path d="M3 9h18"/><path d="M9 21V9"/></svg>
        <span>Admin Studio</span>
      </a>
    </nav>

    <div class="header-actions">
      <a href="https://t.me/ubstabot" target="_blank" rel="noopener" class="creator-badge-btn">
        <span class="online-indicator"></span>
        <span>@deepanshu.fashion</span>
      </a>
    </div>
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    backdrop-filter: blur(16px);
    -webkit-backdrop-filter: blur(16px);
    background: rgba(9, 9, 11, 0.85);
    border-bottom: 1px solid var(--border-subtle);
    padding: 0.85rem 0;
  }

  .header-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
  }

  .brand-logo {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .logo-text {
    font-family: var(--font-heading);
    font-size: 1.5rem;
    font-weight: 800;
    letter-spacing: -0.04em;
    color: #ffffff;
  }

  .logo-dot {
    color: var(--accent-pink);
  }

  .badge-mini {
    font-size: 0.65rem;
    font-weight: 700;
    background: rgba(236, 72, 153, 0.12);
    border: 1px solid rgba(236, 72, 153, 0.25);
    color: var(--accent-pink);
    padding: 0.15rem 0.45rem;
    border-radius: 4px;
    letter-spacing: 0.05em;
  }

  .nav-links {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    background: var(--bg-surface);
    padding: 0.25rem;
    border-radius: 9999px;
    border: 1px solid var(--border-subtle);
  }

  .nav-item {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    font-size: 0.85rem;
    font-weight: 600;
    color: var(--text-muted);
    padding: 0.45rem 0.95rem;
    border-radius: 9999px;
    transition: all 0.2s ease;
  }

  .nav-item:hover {
    color: var(--text-main);
  }

  .nav-item.active {
    background: var(--bg-card);
    color: #ffffff;
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.4);
    border: 1px solid var(--border-subtle);
  }

  .creator-badge-btn {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.8rem;
    font-weight: 600;
    color: var(--text-main);
    background: var(--bg-surface);
    border: 1px solid var(--border-subtle);
    padding: 0.45rem 0.85rem;
    border-radius: 9999px;
    transition: all 0.2s ease;
  }

  .creator-badge-btn:hover {
    border-color: var(--accent-pink);
    color: var(--accent-pink);
  }

  .online-indicator {
    width: 6px;
    height: 6px;
    background-color: var(--accent-emerald);
    border-radius: 50%;
    box-shadow: 0 0 6px var(--accent-emerald);
  }

  @media (max-width: 640px) {
    .nav-links span {
      display: none;
    }
    .creator-badge-btn {
      font-size: 0.75rem;
      padding: 0.35rem 0.65rem;
    }
  }
</style>
