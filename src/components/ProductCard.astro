---
interface Props {
  product: {
    id: string;
    title: string;
    category: string;
    price: number;
    mrp: number;
    discount: string;
    rating: number;
    reviewsCount: number;
    image: string;
    affiliateUrl: string;
    meeshoCode?: string;
  };
}

const { product } = Astro.props;

function money(v: number) {
  return `₹${Number(v || 0).toLocaleString('en-IN')}`;
}
---

<div class="product-card">
  <div class="card-media-wrapper">
    <img
      src={product.image}
      alt={product.title}
      loading="lazy"
      referrerpolicy="no-referrer"
      class="product-img"
    />
    <span class="discount-pill">{product.discount}</span>
    {product.category && <span class="category-tag">{product.category}</span>}
  </div>

  <div class="card-info">
    <div class="rating-row">
      <div class="stars">
        <svg width="12" height="12" viewBox="0 0 24 24" fill="#fbbf24" stroke="#fbbf24"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg>
        <span class="rating-val">{product.rating}</span>
        <span class="reviews-count">({product.reviewsCount})</span>
      </div>
      <span class="verified-tag">Verified Find</span>
    </div>

    <h3 class="product-title" title={product.title}>{product.title}</h3>

    <div class="price-row">
      <div class="price-stack">
        <span class="current-price">{money(product.price)}</span>
        <span class="mrp-price">{money(product.mrp)}</span>
      </div>
      <span class="save-tag">SAVE {money(product.mrp - product.price)}</span>
    </div>

    <div class="card-actions">
      <a
        href={product.affiliateUrl}
        target="_blank"
        rel="noopener noreferrer"
        class="btn-primary-affiliate"
      >
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M6 2 3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4Z"/><line x1="3" x2="21" y1="6" y2="6"/><path d="M16 10a4 4 0 0 1-8 0"/></svg>
        <span>Shop on Meesho</span>
      </a>

      {product.meeshoCode && (
        <button
          type="button"
          class="btn-copy-code"
          data-code={product.meeshoCode}
          onclick={`navigator.clipboard.writeText('${product.meeshoCode}'); const el = this; el.innerText = 'Copied!'; setTimeout(() => { el.innerText = '${product.meeshoCode}'; }, 1800);`}
          title="Click to copy search code for Meesho app"
        >
          {product.meeshoCode}
        </button>
      )}
    </div>
  </div>
</div>

<style>
  .product-card {
    background: var(--bg-surface);
    border: 1px solid var(--border-subtle);
    border-radius: 14px;
    overflow: hidden;
    display: flex;
    flex-direction: column;
    transition: transform 0.2s ease, border-color 0.2s ease, box-shadow 0.2s ease;
  }

  .product-card:hover {
    transform: translateY(-4px);
    border-color: rgba(236, 72, 153, 0.35);
    box-shadow: 0 12px 28px rgba(0, 0, 0, 0.5), 0 0 20px var(--accent-pink-glow);
  }

  .card-media-wrapper {
    position: relative;
    width: 100%;
    aspect-ratio: 1 / 1.15;
    background: #0f0f13;
    overflow: hidden;
  }

  .product-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    transition: transform 0.35s ease;
  }

  .product-card:hover .product-img {
    transform: scale(1.03);
  }

  .discount-pill {
    position: absolute;
    top: 0.65rem;
    left: 0.65rem;
    background: #e11d48;
    color: #ffffff;
    font-size: 0.7rem;
    font-weight: 800;
    padding: 0.2rem 0.5rem;
    border-radius: 6px;
    box-shadow: 0 2px 8px rgba(225, 29, 72, 0.4);
    letter-spacing: 0.02em;
  }

  .category-tag {
    position: absolute;
    bottom: 0.65rem;
    left: 0.65rem;
    background: rgba(9, 9, 11, 0.85);
    backdrop-filter: blur(8px);
    border: 1px solid var(--border-subtle);
    color: var(--text-muted);
    font-size: 0.65rem;
    font-weight: 600;
    padding: 0.15rem 0.45rem;
    border-radius: 4px;
  }

  .card-info {
    padding: 0.95rem;
    display: flex;
    flex-direction: column;
    flex: 1;
    gap: 0.45rem;
  }

  .rating-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    font-size: 0.75rem;
  }

  .stars {
    display: flex;
    align-items: center;
    gap: 0.25rem;
  }

  .rating-val {
    font-weight: 700;
    color: #f4f4f5;
  }

  .reviews-count {
    color: var(--text-muted);
    font-size: 0.7rem;
  }

  .verified-tag {
    font-size: 0.65rem;
    color: var(--accent-emerald);
    font-weight: 600;
  }

  .product-title {
    font-size: 0.9rem;
    font-weight: 600;
    color: var(--text-main);
    line-height: 1.35;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
    min-height: 2.45rem;
  }

  .price-row {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    margin-top: 0.2rem;
  }

  .price-stack {
    display: flex;
    align-items: baseline;
    gap: 0.45rem;
  }

  .current-price {
    font-family: var(--font-heading);
    font-size: 1.25rem;
    font-weight: 800;
    color: #ffffff;
  }

  .mrp-price {
    font-size: 0.8rem;
    color: var(--text-muted);
    text-decoration: line-through;
  }

  .save-tag {
    font-size: 0.65rem;
    font-weight: 700;
    color: var(--accent-emerald);
    background: rgba(16, 185, 129, 0.1);
    padding: 0.15rem 0.4rem;
    border-radius: 4px;
  }

  .card-actions {
    display: grid;
    grid-template-columns: 1fr auto;
    gap: 0.45rem;
    margin-top: 0.35rem;
  }

  .btn-primary-affiliate {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.4rem;
    background: linear-gradient(135deg, #ec4899, #d946ef);
    color: #ffffff;
    font-size: 0.8rem;
    font-weight: 700;
    padding: 0.6rem 0.85rem;
    border-radius: 8px;
    transition: opacity 0.2s ease, transform 0.2s ease;
    box-shadow: 0 4px 14px rgba(236, 72, 153, 0.3);
  }

  .btn-primary-affiliate:hover {
    opacity: 0.95;
    transform: scale(0.99);
  }

  .btn-copy-code {
    background: var(--bg-card);
    border: 1px solid var(--border-subtle);
    color: var(--text-muted);
    font-size: 0.75rem;
    font-weight: 600;
    padding: 0 0.65rem;
    border-radius: 8px;
    transition: all 0.2s ease;
    white-space: nowrap;
  }

  .btn-copy-code:hover {
    border-color: rgba(255, 255, 255, 0.25);
    color: #ffffff;
  }
</style>
